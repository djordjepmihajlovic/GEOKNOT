Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Define", " ", "all", " ", "pieces", " ", "first"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"euRts", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "t1"}], "*", "cbtu"}], "+", 
      RowBox[{"t2", "*", "cbus"}], "+", "a3"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"etRsu", "=", 
     RowBox[{
      RowBox[{"-", "a1"}], "-", 
      RowBox[{"t2", "*", "cbts"}], "+", 
      RowBox[{"t3", "*", "cbtu"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"esRut", "=", 
     RowBox[{
      RowBox[{"t1", "*", "cbts"}], "-", "a2", "-", 
      RowBox[{"t3", "*", "cbus"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"RstRus", "=", 
     RowBox[{
      RowBox[{"a1", "*", "t1"}], "+", 
      RowBox[{"t1", "*", "t2", "*", "cbts"}], "-", 
      RowBox[{"t1", "*", "t3", "*", "cbtu"}], "-", 
      RowBox[{"a1", "*", "t2", "*", "cbts"}], "-", 
      RowBox[{"t2", "^", "2"}], "+", 
      RowBox[{"t2", "*", "t3", "*", "cbus"}], "-", 
      RowBox[{"a3", "*", "a1", "*", "cbtu"}], "-", 
      RowBox[{"a3", "*", "t2", "*", "cbus"}], "+", 
      RowBox[{"a3", "*", "t3"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"radRst", "=", 
     RowBox[{
      RowBox[{"t1", "^", "2"}], "-", 
      RowBox[{"2", " ", "t1", " ", "t2", " ", "cbts"}], "-", 
      RowBox[{"2", " ", "a3", " ", "t1", " ", "cbtu"}], "+", 
      RowBox[{"t2", "^", "2"}], "+", 
      RowBox[{"2", " ", "a3", " ", "t2", " ", "cbus"}], "+", 
      RowBox[{"a3", "^", "2"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"radRus", "=", 
     RowBox[{
      RowBox[{"a1", "^", "2"}], "+", 
      RowBox[{"2", " ", "a1", " ", "t2", " ", "cbts"}], "-", 
      RowBox[{"2", " ", "a1", " ", "t3", " ", "cbtu"}], "+", 
      RowBox[{"t2", "^", "2"}], "-", 
      RowBox[{"2", " ", "t2", " ", "t3", " ", "cbus"}], "+", 
      RowBox[{"t3", "^", "2"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"radRtu", "=", 
     RowBox[{
      RowBox[{"t1", "^", "2"}], "-", 
      RowBox[{"2", " ", "t1", " ", "a2", " ", "cbts"}], "-", 
      RowBox[{"2", " ", "t1", " ", "t3", " ", "cbtu"}], "+", 
      RowBox[{"a2", "^", "2"}], "+", 
      RowBox[{"2", " ", "a2", " ", "t3", " ", "cbus"}], "+", 
      RowBox[{"t3", "^", "2"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"nRst", "=", 
     RowBox[{"Sqrt", "[", "radRst", "]"}]}], ";", 
    RowBox[{"nRus", "=", 
     RowBox[{"Sqrt", "[", "radRus", "]"}]}], ";", 
    RowBox[{"nRtu", "=", 
     RowBox[{"Sqrt", "[", "radRtu", "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"dom", "=", 
     RowBox[{
      RowBox[{"t1min", "<=", "t1", "<=", "t1max"}], "&&", 
      RowBox[{"t2min", "<=", "t2", "<=", "t2max"}], "&&", 
      RowBox[{"t3min", "<=", "t3", "<=", "t3max"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"$Assumptions", "=", 
     RowBox[{
      RowBox[{"Element", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "a1", ",", "a2", ",", "a3", ",", "cbus", ",", "cbtu", ",", "cbts", ",",
           "t1min", ",", "t1max", ",", "t2min", ",", "t2max", ",", "t3min", ",",
           "t3max"}], "}"}], ",", "Reals"}], "]"}], "&&", 
      RowBox[{
       RowBox[{"-", "1"}], "<=", "cbus", "<=", "1"}], "&&", 
      RowBox[{
       RowBox[{"-", "1"}], "<=", "cbtu", "<=", "1"}], "&&", 
      RowBox[{
       RowBox[{"-", "1"}], "<=", "cbts", "<=", "1"}], "&&", 
      RowBox[{"t1min", "<", "t1max"}], "&&", 
      RowBox[{"t2min", "<", "t2max"}], "&&", 
      RowBox[{"t3min", "<", "t3max"}], "&&", 
      RowBox[{"ForAll", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"t1", ",", "t2", ",", "t3"}], "}"}], ",", 
        RowBox[{"dom", "\[Implies]", 
         RowBox[{
          RowBox[{"radRst", ">", "0"}], "&&", 
          RowBox[{"radRus", ">", "0"}], "&&", 
          RowBox[{"radRtu", ">", "0"}], "&&", 
          RowBox[{
           RowBox[{
            RowBox[{"nRst", "*", "nRus"}], "+", "RstRus"}], "!=", "0"}]}]}]}],
        "]"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Y1", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"nRst", "+", "nRus", "-", "nRtu"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"nRst", "*", "nRus", "*", "nRtu"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Y2", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"cbts", "*", "euRts"}], "+", 
        RowBox[{"cbus", "*", "etRsu"}], "+", 
        RowBox[{"cbtu", "*", "esRut"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"nRst", "*", "nRus"}], "+", "RstRus"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Y", "=", 
     RowBox[{"Y1", "*", "Y2"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"resForced", "=", 
     RowBox[{"Integrate", "[", 
      RowBox[{"Y", ",", 
       RowBox[{"{", 
        RowBox[{"t1", ",", "t1min", ",", "t1max"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t2", ",", "t2min", ",", "t2max"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t3", ",", "t3min", ",", "t3max"}], "}"}], ",", 
       RowBox[{"Assumptions", "->", "$Assumptions"}], ",", 
       RowBox[{"GenerateConditions", "->", "True"}]}], "]"}]}], ";"}], 
   "\n"}]}]], "Input",
